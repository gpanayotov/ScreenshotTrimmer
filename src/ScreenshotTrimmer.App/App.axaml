<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ScreenshotTrimmer.App.App"
             RequestedThemeVariant="Default">
  <!-- Default follows the system's light or dark theme, and switches when it does. -->
  <Application.Styles>
    <FluentTheme />
    <!-- Every window, the dialogs too, shows the app's icon. -->
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="/Assets/Icon/screenshot-trimmer.ico" />
    </Style>
  </Application.Styles>
</Application>
