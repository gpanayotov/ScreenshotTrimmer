<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The executable users download is ScreenshotTrimmer(.exe); the code keeps its namespace. -->
    <AssemblyName>ScreenshotTrimmer</AssemblyName>
    <RootNamespace>ScreenshotTrimmer.App</RootNamespace>
    <!-- Builds carry a development version unless CI passes the real one as InformationalVersion
         (see build/version.sh); the SDK must not append its own commit hash to it. -->
    <Version>0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Avalonia 11.3.23 depends on SkiaSharp 2.88.9, the version the processing library is pinned to. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenshotTrimmer.Processing\ScreenshotTrimmer.Processing.csproj" />
  </ItemGroup>

  <!-- The SDK does not generate the resource class on its own; this generates it at build time. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedNamespace>ScreenshotTrimmer.App.Localization</StronglyTypedNamespace>
    </EmbeddedResource>
  </ItemGroup>

</Project>
